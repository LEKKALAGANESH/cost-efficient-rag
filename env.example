# ===========================================================================
# cost-efficient-rag - environment template
#
#     cp env.example .env
#
# .env is gitignored; this template is committed. No real secret ever lives
# here, in config.py defaults, or in any log line.
# ===========================================================================
#
# ###########################################################################
# #                                                                         #
# #  >>> REQUIRED KEYS <<<  Fill these two in. Everything else in this file #
# #                         already has a working default.                  #
# #                                                                         #
# #      1. GROQ_API_KEY     -> https://console.groq.com/keys               #
# #      2. GEMINI_API_KEY   -> https://aistudio.google.com/apikey          #
# #                                                                         #
# #  Both are free tier and neither requires a card.                        #
# #                                                                         #
# ###########################################################################
#
# WHAT RUNS WITH NO KEY AT ALL:
#   - ingestion (PDF / HTML / Markdown), embedding, indexing, retrieval
#   - every retrieval metric (Recall@k, Hit Rate, MRR, nDCG@k, precision)
#   - the entire cost model
#   - the full test suite:  python -m pytest        (255 tests, offline)
#
# WHAT NEEDS A KEY:
#   - grounded answer generation   -> GROQ_API_KEY
#   - the LLM judge                -> GEMINI_API_KEY (Groq is the fallback)
#
# A missing or dead key no longer stops the app. The provider chain reports
# what it can reach and degrades to an offline evaluator, so an evaluation
# still produces labelled measurements instead of nothing at all.

# ---------------------------------------------------------------------------
# REQUIRED 1/2 - generation
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_replace_me

# ---------------------------------------------------------------------------
# REQUIRED 2/2 - judging
# Note: the Gemini free tier is metered at 20 requests per DAY for
# gemini-3.5-flash (measured; Google does not publish it), which is why Groq
# leads the judge chain below.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=replace_me

# --- OPTIONAL: extra providers for the fallback chain ----------------------
# Add any of these to LLM_PROVIDER_CHAIN / JUDGE_PROVIDER_CHAIN without a code
# change. Leave blank to skip that provider entirely.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# DEEPINFRA_API_KEY=
# AZURE_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=

# --- Provider routing ------------------------------------------------------
# Ordered fallback chain, tried left to right. Switching providers is an edit
# here; no call site names a vendor. Local providers (ollama/, lm_studio/,
# hosted_vllm/) need no key and belong last -- a terminal option that cannot
# fail on authentication.
LLM_PROVIDER_CHAIN=groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash
JUDGE_PROVIDER_CHAIN=groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash
PROVIDER_FAILURE_THRESHOLD=2
RETRY_BACKOFF_BASE_SECONDS=1.0
RETRY_BACKOFF_CAP_SECONDS=45.0
# Terminal offline evaluator. Its scores are labelled `local-embedding` and are
# never pooled with LLM-judge scores -- a different instrument, not a substitute.
ENABLE_LOCAL_FALLBACK=true
# Client-side tokens-per-minute pacing. TPM binds before RPM for this workload.
DEFAULT_TOKENS_PER_MINUTE=8000

# --- Vector backend --------------------------------------------------------
# lancedb (default, embedded, zero-account) | supabase (bonus benchmark)
VECTOR_BACKEND=lancedb
VECTOR_STORE_PATH=./data/lancedb_store
VECTOR_TABLE_NAME=rag_chunks

# Required ONLY when VECTOR_BACKEND=supabase. Use the Session pooler string
# (IPv4); the direct connection string is IPv6-only on the Supabase free tier.
# postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_DB_URL=

# --- Embeddings ------------------------------------------------------------
# 384-dim, local CPU inference, $0 marginal cost, no API quota.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Chunking (defaults documented in README) ------------------------------
# Fixed a priori at 500/50; NOT selected against the frozen eval set.
# all-MiniLM-L6-v2 truncates silently at 256 tokens (~1000 chars), so
# chunk_size > 900 embeds only the head of every chunk. config.py warns.
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# --- Retrieval -------------------------------------------------------------
DEFAULT_TOP_K=5
# Calibrated on data/threshold_calibration.json - see README "Fallback threshold".
SIMILARITY_THRESHOLD=0.3

# --- Generation / judge ----------------------------------------------------
GENERATION_MODEL=groq/openai/gpt-oss-120b
JUDGE_MODEL=gemini/gemini-3.5-flash
GENERATION_TEMPERATURE=0.0
GENERATION_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=5
LLM_CACHE_PATH=./.cache/llm

# --- API limits ------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
MAX_FILES_PER_REQUEST=20
MAX_QUERY_CHARS=2000
MAX_PDF_PAGES=500
# Comma-separated allowlist for /query metadata_filter keys. Anything else -> 422.
ALLOWED_FILTER_KEYS=file_type,source,doc_key

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
QUERY_LOG_PATH=./logs/queries.jsonl
